# =============================================================================
# 투자 리허설 — 환경 변수 예시
# -----------------------------------------------------------------------------
# 실제 키는 이 파일이 아니라 .env.local 에만 저장하세요. (.env.local 은 gitignore)
# 사용법: 이 파일을 복사해서 .env.local 을 만들고 값만 채워 넣습니다.
#   cp .env.example .env.local
#
# production(Cloudflare Pages)에는 이 값들을 파일이 아니라 secret 으로 등록합니다.
#   npx wrangler pages secret put <NAME> --project-name <프로젝트명>
# =============================================================================

# --- 서버(BFF) 전용 — 브라우저 번들에 절대 포함되지 않는다 ----------------------
# 계획 해석(POST /api/plan/interpret) · 수정(POST /api/plan/revise) · 결과 설명
# (POST /api/review) 에서 쓴다.
ANTHROPIC_API_KEY=
# 미설정 시 기본값 claude-sonnet-5.
LLM_MODEL=

# 해외 종목 검색·시세(GET /api/symbols, /api/quote)에서 쓴다.
FINNHUB_API_KEY=
# 해외 종목 과거 일별 가격(GET /api/candles)에서 쓴다.
TWELVE_DATA_API_KEY=
# 국내(KR) 과거 일별 가격은 Yahoo Finance(GET /api/candles/kr) 를 쓴다 — 키 불필요.

# --- 사용성 피드백 설문(/feedback) --------------------------------------------
# 설문 응답을 실제로 전달할 Google Apps Script Web App URL. 비어 있으면 route·설문
# UI는 정상 동작하지만, 실제 제출 시 "의견을 보내지 못했어요"를 정직하게 보여준다
# (가짜 성공 표시 금지).
FEEDBACK_APPS_SCRIPT_URL=
# (선택) 연결한 Apps Script 의 doPost 가 별도로 토큰을 검증하도록 만들었을 때만
# 채운다 — 검증하지 않는 구조라면 비워 둬도 정상 동작한다.
FEEDBACK_API_TOKEN=

# --- 클라이언트에도 노출되는 빌드타임 플래그(VITE_ 접두사, 키 아님) ----------------
# true 여야 결과 화면에 "사용성 피드백 남기기" 버튼과 /feedback route 가 나타난다.
VITE_ENABLE_FEEDBACK=false
# true 면 실제 API 대신 결정적 합성 데이터(오프라인 데모)를 쓴다 — 개발용, 배포
# 환경에서는 설정하지 않는다.
VITE_USE_MOCK_MARKET=false
VITE_USE_MOCK_AI=false

# =============================================================================
# 아래는 spikes/ 안의 초기 기술 검증 스크립트 전용이다 — 실제 앱(app/, server/,
# functions/)은 이 값들을 읽지 않는다.
# =============================================================================
LLM_PROVIDER=mock
OPENAI_API_KEY=
MARKET_PROVIDER=mock
ALPHAVANTAGE_API_KEY=
SPIKE_QUERY=
