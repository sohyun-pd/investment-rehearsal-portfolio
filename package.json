{
  "name": "investment-rehearsal-portfolio",
  "version": "0.0.1",
  "private": true,
  "description": "투자 리허설 — 자연어 투자 계획을 과거 1년 실제 가격에 적용해보는 AI 시뮬레이션 프로토타입 (포트폴리오 버전)",
  "type": "module",
  "scripts": {
    "spike:llm": "tsx spikes/llm-parser/test.ts",
    "spike:strategy": "tsx spikes/llm-parser/strategy-test.ts",
    "spike:market": "tsx spikes/market-api/test.ts",
    "spike:history:twelve": "tsx spikes/historical-market-data-twelve-data/test.ts",
    "spike:history:adjustment": "tsx spikes/historical-market-data-twelve-data/adjustment-check.ts",
    "spike:all": "npm run spike:llm && npm run spike:market",
    "test:simulation": "tsx --test app/domain/simulation/*.test.ts",
    "test:market": "tsx --test app/data/market/*.test.ts",
    "test:plancard": "tsx --test app/components/app/PlanCard.test.ts",
    "test:flow": "tsx --test app/flow/FlowProvider.test.ts",
    "test:alias": "tsx --test app/screens/koreanStockAlias.test.ts",
    "test:revise": "tsx --test server/planReviseRoute.test.ts",
    "test:marketroutes": "tsx --test server/marketRoutes.test.ts",
    "test:koreanstocks": "tsx --test app/data/market/koreanStocks.test.ts",
    "test:screenchat": "tsx --test app/screens/ScreenChat.test.ts",
    "test:parsers": "tsx --test app/lib/answerParsers.test.ts",
    "test:simulationcopy": "tsx --test app/lib/simulationCopy.test.ts",
    "test:analysis": "tsx --test app/screens/Screen4Analysis.test.ts",
    "test:chartmarkers": "tsx --test app/lib/chartMarkers.test.ts",
    "test:feedback": "tsx --test server/feedbackRoute.test.ts",
    "test:feedbacktypes": "tsx --test app/features/feedback/feedback.types.test.ts",
    "test:feedbackpage": "tsx --test app/features/feedback/FeedbackPage.test.ts",
    "test:planstorage": "tsx --test app/session/planStorage.test.ts",
    "test:appplan": "tsx --test app/types/appPlan.test.ts",
    "test:yahookr": "tsx --test app/data/market/yahooKoreanAdapter.test.ts",
    "test:reviewfallback": "tsx --test app/lib/reviewFallback.test.ts",
    "test:review": "tsx --test server/reviewRoute.test.ts",
    "test:ratelimit": "tsx --test server/rateLimit.test.ts",
    "test:requestguards": "tsx --test server/requestGuards.test.ts",
    "test": "npm run -s test:simulation && npm run -s test:market && npm run -s test:plancard && npm run -s test:flow && npm run -s test:alias && npm run -s test:revise && npm run -s test:marketroutes && npm run -s test:koreanstocks && npm run -s test:screenchat && npm run -s test:parsers && npm run -s test:simulationcopy && npm run -s test:analysis && npm run -s test:chartmarkers && npm run -s test:feedback && npm run -s test:feedbacktypes && npm run -s test:feedbackpage && npm run -s test:planstorage && npm run -s test:appplan && npm run -s test:yahookr && npm run -s test:reviewfallback && npm run -s test:review && npm run -s test:ratelimit && npm run -s test:requestguards",
    "smoke:ui": "node spikes/ui-smoke.mjs",
    "spike:simulation:live": "tsx spikes/live-simulation/run.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy": "wrangler pages deploy dist"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "tailwind-merge": "^3.6.0"
  }
}
